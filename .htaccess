DirectoryIndex index.php
# Неизвестные адреса отдаёт route.php (в конце файла); это — для отсутствующих файлов
ErrorDocument 404 /404.php

# Header и ErrorDocument ниже OpenLiteSpeed не выполняет (работают на Apache): noindex и заголовки
# безопасности ставит PHP, кэш статики — настройка сервера (/etc/openlitespeed/httpd-expires.conf)

# DEV-ONLY: сайт закрыт от индексации на время разработки. Убрать при запуске (doc/ROADMAP.md, этап 7)
<IfModule mod_headers.c>
	Header always set X-Robots-Tag "noindex, nofollow"
</IfModule>

# Типы файлов
AddType font/woff2 .woff2
AddType application/manifest+json .webmanifest

# Кэш браузера. CSS и JS подключаются через asset() с ?v= (меняется вместе с файлом),
# шрифт при изменении получает новое имя, поэтому всё это кэшируется на год.
# Картинки и иконки без версии кэшируются на неделю
<IfModule mod_headers.c>
	<FilesMatch "\.(css|js|woff2)$">
		Header set Cache-Control "public, max-age=31536000, immutable"
	</FilesMatch>
	<FilesMatch "\.(svg|png|jpe?g|webp|avif|ico|webmanifest)$">
		Header set Cache-Control "public, max-age=604800"
	</FilesMatch>
</IfModule>

# Сжатие текстовых ответов (если сервер не делает его сам)
<IfModule mod_deflate.c>
	AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript image/svg+xml application/xml application/json application/manifest+json
</IfModule>

RewriteEngine On

# Один адрес сайта: http:// и www → https://place4market.com (301, путь и параметры сохраняются).
# Только для боевого домена; проверка Let's Encrypt (/.well-known/acme-challenge/) идёт без редиректа
RewriteCond %{HTTP_HOST} ^(www\.)?place4market\.com$ [NC]
RewriteCond %{HTTPS} !^on$ [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
RewriteRule ^ https://place4market.com%{REQUEST_URI} [R=301,L]

# Карта сайта генерируется PHP (sitemap.php тоже открывается напрямую)
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# Служебные PHP-файлы подключаются только через include, напрямую из браузера не открываются
# (и с хвостом после имени: /source/inc/repo.php/x раньше выполнялся)
RewriteRule ^source/.*\.php(/|$) - [F,L]
RewriteRule ^source/(inc|lang)/ - [F,L]

# Журнал на проде лежит вне public_html; это правило на случай, если папка logs окажется внутри
RewriteRule ^logs/ - [F,L]
RewriteRule ^source/db/ - [F,L]
RewriteRule ^config/ - [F,L]
RewriteRule ^uploads/.*\.(php|phtml|phar)$ - [F,L]

# Человекочитаемые адреса (/oglasi/vozila/automobili, /en/listing/…, /pomoc): всё, что не файл
# и не папка, — в route.php. Он же отдаёт нашу 404 на неизвестные адреса. Должно идти последним
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ route.php [L]

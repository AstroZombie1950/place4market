DirectoryIndex index.php
ErrorDocument 404 /404.php

# DEV-ONLY: сайт закрыт от индексации на время разработки. Убрать при запуске (doc/ROADMAP.md, этап 6)
<IfModule mod_headers.c>
	Header always set X-Robots-Tag "noindex, nofollow"
</IfModule>

RewriteEngine On

# Главная только по адресу /, без дубля /index.php
RewriteCond %{THE_REQUEST} \s/index\.php[?\s]
RewriteRule ^index\.php$ / [R=301,L]

# Карта сайта генерируется PHP
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# Служебные PHP-файлы подключаются только через include, напрямую из браузера не открываются
RewriteRule ^source/.*\.php$ - [F,L]

# Файл состояния деплоя (список файлов и хэшей) наружу не отдаём
RewriteRule ^\.ftp-deploy-sync-state\.json$ - [F,L]
